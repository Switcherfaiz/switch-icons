{
  "name": "switch-framework-icons",
  "version": "0.3.0",
  "description": "First-party icon font for Switch Framework. CSS + span independently, or import 'switch-framework-icons' for <sw-icon>.",
  "author": "Switcherfaiz",
  "github": "https://github.com/Switcherfaiz/switch-framework-icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Switcherfaiz/switch-framework-icons.git"
  },
  "homepage": "https://github.com/Switcherfaiz/switch-framework-icons#readme",
  "bugs": {
    "url": "https://github.com/Switcherfaiz/switch-framework-icons/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./style.css": "./style.css",
    "./names.json": "./names.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "names.js",
    "names.json",
    "style.css",
    "fonts",
    "html",
    "scripts",
    "logo.svg"
  ],
  "scripts": {
    "build": "node ./scripts/build-names.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "switch-framework",
